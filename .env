# Copy to .env and adjust. Never commit .env with real secrets.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=momnaa.javed@gmail.com
SMTP_PASSWORD=orax kner ftcw fqla
SMTP_FROM=Rezume AI <momnaa.javed@gmail.com>
SMTP_USE_TLS=true
VERIFICATION_CODE_TTL_MINUTES=15

DEV_EMAIL_PRINT_CODE=false
# Database (SQLAlchemy URL).
#
# FYP defense / demo (Postgres in Docker — run: bash scripts/defense_postgres_ready.sh):
DATABASE_URL=postgresql+psycopg2://rezume:rezume@localhost:5432/rezumeai
#
# Local dev without Docker (embedded file ./rezume_dev.db) — comment out DATABASE_URL above:
# (delete DATABASE_URL line or use SQLite explicitly)
# DATABASE_URL=sqlite+pysqlite:///./rezume_dev.db

# Comma-separated origins for browser apps (Vite default 5173)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Optional API prefix (default /api/v1)
# API_PREFIX=/api/v1

# --- Email verification ---
# For now, enable dev mode so registration works without SMTP.
DEV_EMAIL_PRINT_CODE=true
