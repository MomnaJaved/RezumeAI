# Copy to .env. Repo root = working directory for API and training scripts.

# Database: omit for default SQLite at repo root (rezume_dev.db).
# If you set sqlite+pysqlite:///./rezume_dev.db, the file path is resolved from repo root (not shell cwd).
# Postgres (after: bash training/scripts/defense_postgres_ready.sh):
# DATABASE_URL=postgresql+psycopg2://rezume:rezume@localhost:5432/rezumeai

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Optional — inference tuning (see src/inference/service.py)
# REZUME_ROLE_NO_DYNAMIC_QUANT=1   # CPU only: keep float32 role model (slower, tiny accuracy change)
# REZUME_MATCH_NO_DYNAMIC_QUANT=1  # CPU only: keep float32 cross-encoder
# REZUME_MATCH_BATCH_SIZE=32       # Pairs per forward when ranking many candidates (1–128)
# REZUME_TORCH_COMPILE=1           # CUDA only: torch.compile role + match models (experimental)

# Security (production: set strong JWT_SECRET; optional upload lock)
# JWT_SECRET=change-me-use-long-random-string
# JWT_EXPIRE_MINUTES=60
# REQUIRE_AUTH=false

# Email verification (required to register new accounts)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=Rezume AI <your-email@gmail.com>
# SMTP_USE_TLS=true
# VERIFICATION_CODE_TTL_MINUTES=15

# Model version labels (reported by GET /api/v1/meta/models)
# MODEL_VERSION_TFIDF=model_v1_tfidf
# MODEL_VERSION_SBERT=model_v2_sbert
# MODEL_VERSION_CROSSENCODER=model_v3_crossencoder
# MODEL_VERSION_ROLE=model_v3_role_roberta

# Tests / containers
# SKIP_MODEL_WARMUP=true
# REZUME_TESTING=1
