# Copy this file to .env and fill in your own values. Never commit .env.

# --- SMTP (Email) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password   # 16-char Gmail App Password (no spaces)
SMTP_FROM=your-email@gmail.com
SMTP_USE_TLS=false
SMTP_SSL=true
SMTP_DEBUG=false
VERIFICATION_CODE_TTL_MINUTES=15

# --- Database ---
#
# Local team / Docker (no shared cloud DB):
# DATABASE_URL=postgresql+psycopg2://rezume:rezume@localhost:5432/rezumeai
#
# Shared cloud (Supabase) — use Transaction pooler for production + multi-machine dev:
# Dashboard → Connect → Direct → "Transaction" → copy URI, then:
#   - Use postgresql+psycopg2://...  (not postgresql://)
#   - Port must be 6543 on ...pooler.supabase.com
#   - Append ?sslmode=require if not already present
# Example shape:
# DATABASE_URL=postgresql+psycopg2://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
#
# If you only have Session pooler (:5432), the API uses NullPool so connections are not
# held between requests — safe for a few laptops, but prefer Transaction (:6543) above.
#
# SQLite (solo dev, no Postgres):
# DATABASE_URL=sqlite+pysqlite:///./rezume_dev.db
#
DATABASE_URL=postgresql+psycopg2://rezume:rezume@localhost:5432/rezumeai

# --- Auth ---
REQUIRE_AUTH=true
JWT_EXPIRE_MINUTES=10080

# --- CORS ---
# Include 5174 if Vite picked the next free port when 5173 was busy.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000

# --- Storage ---
REZUME_STORAGE_ROOT=~/.rezumeai

# --- OpenAI ---
OPENAI_API_KEY=sk-...your-openai-key-here...

# --- Optional ---
# API_PREFIX=/api/v1
DEV_EMAIL_PRINT_CODE=false
