# Copy this file to .env and fill in your own values. Never commit .env.

# --- SMTP (Email) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password   # 16-char Gmail App Password (no spaces)
SMTP_FROM=your-email@gmail.com
SMTP_USE_TLS=false
SMTP_SSL=true
SMTP_DEBUG=false
VERIFICATION_CODE_TTL_MINUTES=15

# --- Database ---
# Postgres via Docker (recommended):
DATABASE_URL=postgresql+psycopg2://rezume:rezume@localhost:5432/rezumeai
# OR SQLite for quick local dev (no Docker needed):
# DATABASE_URL=sqlite+pysqlite:///./rezume_dev.db

# --- Auth ---
REQUIRE_AUTH=true
JWT_EXPIRE_MINUTES=10080

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# --- Storage ---
REZUME_STORAGE_ROOT=~/.rezumeai

# --- OpenAI ---
OPENAI_API_KEY=sk-...your-openai-key-here...

# --- Optional ---
# API_PREFIX=/api/v1
DEV_EMAIL_PRINT_CODE=false
